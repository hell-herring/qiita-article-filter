{
  "name": "qiita-article-filter",
  "version": "1.0.0",
  "private": true,
  "description": "Qiita で特定のユーザーや Organization の記事を一覧から隠す Chrome 拡張機能",
  "type": "module",
  "scripts": {
    "test": "node --test test/content.test.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test",
    "icons": "node scripts/generate-icons.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "jsdom": "^24.1.0",
    "prettier": "^3.9.6"
  }
}
